#!/usr/bin/env bash
source "$(dirname "$0")/lib.sh"
which="${1:-all}"
[ $# -gt 0 ] && shift
case "$which" in
  all|unit|engine) ;;
  *) fx_say "unknown test layer: $which (use unit, engine or nothing for all)"; exit 2 ;;
esac
fail=0
run() { fx_say "$1"; shift; "$@" || fail=1; }
wants() { [ "$which" = all ] || [ "$which" = "$1" ]; }
if wants unit; then
  [ -d "$FORMEXT_ROOT/frontend/node_modules" ] || fx_die "the interface packages are missing, run ./formext install"
  cd "$FORMEXT_ROOT/frontend"
  run "interface logic (vitest)" npx vitest run "$@"
fi
if wants engine; then
  py="$FORMEXT_ROOT/backend/venv/bin/python"
  [ -x "$py" ] || py="$FORMEXT_ROOT/backend/venv/Scripts/python.exe"
  [ -x "$py" ] || fx_die "the backend venv is missing, run ./formext install"
  "$py" -c "import pytest, httpx" >/dev/null 2>&1 || fx_die "the engine tests need pytest and httpx: $py -m pip install pytest httpx"
  cd "$FORMEXT_ROOT"
  run "engine (pytest)" "$py" -m pytest tests -q -p no:cacheprovider "$@"
fi
exit "$fail"
