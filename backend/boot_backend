#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
if [ ! -x venv/bin/python ]; then
  echo "[formext] creating the backend venv" >&2
  python3.12 -m venv venv
  venv/bin/pip install -q -r requirements.txt
fi
host="${FORMEXT_HOST:-127.0.0.1}"
port="${FORMEXT_PORT:-8640}"
if [ "${FORMEXT_RELOAD:-1}" = 1 ]; then
  exec venv/bin/python -m uvicorn app.main:app --reload --reload-dir app --host "$host" --port "$port"
fi
exec venv/bin/python -m uvicorn app.main:app --host "$host" --port "$port"
