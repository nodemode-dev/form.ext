#!/usr/bin/env bash
set -e
root="$(cd "$(dirname "$0")" && pwd)"
pybin="$(command -v python3.12 || command -v python3)"
[ -n "$pybin" ] || { echo "[formext] Python 3.12 is needed" >&2; exit 1; }
command -v npm > /dev/null || { echo "[formext] Node.js 20.19 or newer is needed" >&2; exit 1; }
echo "[formext] engine: backend/venv"
[ -x "$root/backend/venv/bin/python" ] || "$pybin" -m venv "$root/backend/venv"
"$root/backend/venv/bin/python" -m pip install -q --upgrade pip
"$root/backend/venv/bin/python" -m pip install -q -r "$root/backend/requirements.txt"
echo "[formext] interface: frontend/node_modules"
(cd "$root/frontend" && npm ci --no-audit --no-fund)
chmod +x "$root/formext" "$root/formext_oc_install" "$root/build_app" "$root/backend/boot_backend" "$root/setup/freeze_backend" 2>/dev/null || true
echo "[formext] done. Start with ./formext (then open http://localhost:5640); ./formext agents install connects Claude Code, Codex and Cursor"
