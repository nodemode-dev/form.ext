#!/usr/bin/env bash
set -e
root="$(cd "$(dirname "$0")" && pwd)"
version() { sed -n "s/^export const VERSION = '\(.*\)';$/\1/p" "$root/frontend/src/shell/version.ts" 2>/dev/null; }
usage() {
  printf 'form.ext %s · the Form extension studio\n' "$(version)"
  cat << 'EOF'

usage: ./formext [command] [options]

  (none) | boot       engine (127.0.0.1:8640) and interface (localhost:5640) together; reuses either if it already runs
  install             one-command install: backend venv and frontend packages (same as ./formext_oc_install)
  backend             the engine only (reloads on backend/app changes)
  frontend            the interface only (Vite on 5640)
  build               production build of the interface into frontend/dist
  serve               the built interface served by the engine on http://127.0.0.1:8640
  freeze              freeze the engine into the Tauri sidecar (src-tauri/binaries/formext-engine-<target>)
  desktop dev|build   run or bundle the desktop app (Tauri 2)
  app [options]       build the desktop app start to finish (same as ./build_app; --open, --clean, --no-install, --install)
  cli ...             the formext command line (new, validate, preview, package, sign, run-in-app, publish); cli --help
  mcp ...             the formext MCP server on stdio, for Claude Code and other MCP clients
  claude [args]       Claude Code in this folder, already connected to the formext tools (and formMCP when it is installed)
  agents install|status|sync  set up Claude Code, Codex and Cursor for making extensions in plain language (install), say what is set up (status), or refresh the skill references and the .agents mirror (sync [--check])
  doctor              check the toolchain, installs and ports
  version             the version (also --version)
  help                this text
EOF
}
listening() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
py() {
  if [ -x "$root/backend/venv/bin/python" ]; then echo "$root/backend/venv/bin/python"; else command -v python3.12 || command -v python3; fi
}
ensure_frontend() {
  if [ ! -d "$root/frontend/node_modules" ]; then
    echo "[formext] installing the interface packages" >&2
    (cd "$root/frontend" && npm ci --no-audit --no-fund)
  fi
}
run_backend() { exec "$root/backend/boot_backend" "$@"; }
run_frontend() { ensure_frontend; cd "$root/frontend"; exec node node_modules/.bin/vite "$@"; }
boot() {
  ensure_frontend
  pids=()
  stop() { [ ${#pids[@]} -gt 0 ] && kill "${pids[@]}" 2>/dev/null; wait 2>/dev/null; }
  trap 'stop; exit 0' INT TERM
  trap stop EXIT
  if listening 8640; then echo "[formext] engine already on 127.0.0.1:8640, reusing it"; else "$root/backend/boot_backend" & pids+=($!); fi
  if listening 5640; then echo "[formext] interface already on localhost:5640, reusing it"; else (cd "$root/frontend" && exec node node_modules/.bin/vite) & pids+=($!); fi
  echo "[formext] open http://localhost:5640"
  if [ ${#pids[@]} -gt 0 ]; then wait; fi
}
target_triple() { rustc -vV 2>/dev/null | sed -n 's/^host: //p'; }
freeze() {
  [ -x "$root/setup/freeze_backend" ] || { echo "[formext] setup/freeze_backend is missing" >&2; exit 1; }
  "$root/setup/freeze_backend" "$@"
}
desktop() {
  sub="${1:-dev}"
  [ $# -gt 0 ] && shift
  ensure_frontend
  cd "$root"
  case "$sub" in
    dev)
      if ! listening 8640 || ! listening 5640; then
        "$0" boot > /dev/null 2>&1 &
        for _ in $(seq 1 60); do listening 8640 && listening 5640 && break; sleep 0.5; done
      fi
      exec node frontend/node_modules/.bin/tauri dev --no-dev-server-wait "$@" ;;
    build) exec "$root/build_app" "$@" ;;
    *) usage; exit 2 ;;
  esac
}
passthrough() {
  mod="$1"
  shift
  if [ -x "$root/cli/formext" ] && [ "$mod" = cli ]; then exec "$root/cli/formext" "$@"; fi
  if [ ! -f "$root/backend/app/$mod.py" ] && [ ! -d "$root/backend/app/$mod" ]; then
    echo "[formext] backend/app/$mod.py is not there yet" >&2
    exit 1
  fi
  PYTHONPATH="$root/backend${PYTHONPATH:+:$PYTHONPATH}" exec "$(py)" -m "app.$mod" "$@"
}
doctor() {
  ok() { printf '  %-10s %s\n' "$1" "$2"; }
  ok node "$(node -v 2>/dev/null || echo missing)"
  ok npm "$(npm -v 2>/dev/null || echo missing)"
  ok python "$("$(py)" -V 2>&1 || echo missing)"
  ok venv "$([ -x "$root/backend/venv/bin/python" ] && echo backend/venv || echo 'missing (./formext_oc_install)')"
  ok packages "$([ -d "$root/frontend/node_modules" ] && echo frontend/node_modules || echo 'missing (./formext_oc_install)')"
  ok claude "$(command -v claude || echo 'missing (https://claude.com/claude-code)')"
  ok rust "$(rustc -V 2>/dev/null || echo 'missing (desktop builds only)')"
  ok target "$(target_triple || true)"
  ok engine "$(listening 8640 && echo 'listening on 8640' || echo 'not running')"
  ok interface "$(listening 5640 && echo 'listening on 5640' || echo 'not running')"
}
cmd="${1:-boot}"
[ $# -gt 0 ] && shift
case "$cmd" in
  boot|dev) boot ;;
  install) exec "$root/formext_oc_install" "$@" ;;
  app) exec "$root/build_app" "$@" ;;
  claude)
    command -v claude > /dev/null || { echo "[formext] Claude Code is not installed. Install it with: curl -fsSL https://claude.ai/install.sh | bash" >&2; exit 1; }
    cd "$root"
    export CLAUDE_PROJECT_DIR="$root"
    exec claude --mcp-config "$root/.mcp.json" --allowedTools mcp__formext mcp__formmcp "$@" ;;
  agents) exec "$(py)" "$root/setup/agents.py" "$@" ;;
  backend) run_backend "$@" ;;
  frontend) run_frontend "$@" ;;
  build) ensure_frontend; cd "$root/frontend"; exec npm run build ;;
  serve)
    [ -f "$root/frontend/dist/index.html" ] || { ensure_frontend; (cd "$root/frontend" && npm run build); }
    echo "[formext] open http://127.0.0.1:8640"
    FORMEXT_RELOAD=0 exec "$root/backend/boot_backend" "$@" ;;
  freeze) freeze "$@" ;;
  desktop) desktop "$@" ;;
  cli) passthrough cli "$@" ;;
  mcp) passthrough mcp "$@" ;;
  doctor) doctor ;;
  version|--version|-V) printf 'form.ext %s\n' "$(version)" ;;
  help|-h|--help) usage ;;
  *) printf '[formext] unknown command: %s\n\n' "$cmd"; usage; exit 2 ;;
esac
